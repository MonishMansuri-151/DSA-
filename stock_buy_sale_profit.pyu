# brute force approch 
calculate the profit stock buy and sell 
def stock_price(arr):
    difference = 0 
    profit  = 0 
    for i in range(len(arr)):
        for j in range(i+1,len(arr)):
            if arr[j] > arr[i]:
                difference = arr[j] - arr[i]
                profit = max(profit,difference)
    return profit
    
arr = [7,2,1,5,6,4,8] time complexity(n(n+1))/2 
print(stock_price(arr)) 

# optimal solution 
--------------------------------------------------------------
def stock_price(arr):
    minimum = float("inf") 
    max_profit = float("-inf")
    diff = 0
    for i in range(len(arr)):
        minimum = min(minimum,arr[i]) 
        if arr[i] < minimum:
            minimum = arr[i]
        else:
            max_profit = max(max_profit,arr[i]-minimum) 
    return max_profit
        
arr = [7,2,1,5,6,4,8] 
print(stock_price(arr))

0(n) Time complexity 
space = (1)
